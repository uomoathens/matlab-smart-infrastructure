  "title": "MATLAB for Smart Infrastructure: companion code for Chapter 15 of MATLAB for Civil Engineers",
  "creators": [
    {
      "name": "Sargiotis, Dimitrios",
      "affiliation": "School of Civil Engineering, National Technical University of Athens",
